    ROT["Штрафи й бонуси сівозміни<br/>зарано повернулися на поле — штраф"]
  end

  SCORE["Рейтинг культур<br/>і планів сівозміни"]

  PM --> RF --> TER --> OUT1["Climate: шанси<br/>суше / норма / вологіше"]
  PC --> HGB
