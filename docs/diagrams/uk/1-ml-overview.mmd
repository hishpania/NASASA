    SOIL["USDA SSURGO<br/>кислотність ґрунту, США"]
    SG["ISRIC SoilGrids<br/>кислотність ґрунту, увесь світ"]
    ECO["Каталог 17 культур<br/>агрономічні вимоги FAO ECOCROP<br/>+ інтервал повернення на поле"]
  end

  subgraph M1["Модель 1: сезонний прогноз"]
    RF["Random Forest на відхиленнях від норми<br/>окремо на кожен місяць уперед"]
