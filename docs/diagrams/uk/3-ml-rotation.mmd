flowchart TB
  subgraph COLLECT["Звідки дані для навчання"]
    SAMPLE["Випадкові точки в 12 аграрних регіонах США<br/>більше точок там, де більше ріллі"]
    KEEP["Лишаємо точки, де в 2024 росла<br/>польова культура або був пар"]
    HIST["USDA Cropland Data Layer:<br/>що росло в точці кожного року 2016–2024"]
    NORMS["NASA POWER: кліматичні норми точки"]
    ROWS["Приклад = точка × рік 2018–2024<br/>відповідь: культура цього року<br/>вхід: клімат + культури двох попередніх років"]
  end
  SAMPLE --> KEEP --> HIST --> ROWS
  KEEP --> NORMS --> ROWS

  DS["Датасет: 4 250 прикладів, 650 полів, 14 культур<br/>рідкісні культури відкинуто<br/>кукурудза й соя — майже дві третини"]
  ROWS --> DS

  subgraph FEAT["Ознаки"]
    CF["Клімат: сума тепла, довжина сезону,<br/>температура сезону, морози,<br/>опади за рік і за сезон, вологість ґрунту,<br/>вологість повітря, сонце, висота"]
    HF["Сівозміна: культура рік тому і два роки тому"]
  end
  DS --> CF & HF

  MODEL["Gradient Boosting<br/>навмисно невеликі дерева,<br/>щоб модель не запам'ятовувала поля"]
  CF & HF --> MODEL

  subgraph VAL["Як отримали метрику"]
    GKF["Крос-валідація на 5 частин за полями:<br/>тестуємо лише на полях, яких модель не бачила"]
    BASE["Baseline: найчастіша культура<br/>після такої ж пари попередніх"]
    MET["Точність 67 % проти 64 % у baseline<br/>правильна культура в топ-3 — 92 %"]
  end
  MODEL --> GKF --> MET
  BASE --> MET

  subgraph INFER["Що бачить користувач"]
    PROBA["Частка схожих полів США,<br/>де після цих культур сіяли кожну"]
    RULES["Агрономія: тепло й вода за цикл,<br/>надлишок опадів, перезимівля, кислотність ґрунту<br/>+ штрафи й бонуси сівозміни"]
    BLEND["Бал культури = навпіл<br/>модель і агрономія"]
  end
  MODEL --> PROBA --> BLEND
  RULES --> BLEND

  OUTSIDE["Поза США або без історії з супутника:<br/>лише агрономія"]
  RULES --> OUTSIDE

  BLEND --> OUT["Топ-6 культур з причинами<br/>«Сіяли далі на X % схожих полів»<br/>+ план «Типова для схожих полів»"]
  OUTSIDE --> OUT
