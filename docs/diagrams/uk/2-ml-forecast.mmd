flowchart TB
  SRC["NASA POWER помісячно, ~25 років для точки поля<br/>температура, опади за місяць, вологість ґрунту<br/>пропуски заповнюємо між сусідніми місяцями"]

  SRC --> SPLIT{"Розбиття за часом"}
  SPLIT -->|"усе, крім останніх 2 років"| TRAIN["Навчання"]
  SPLIT -->|"останні 2 роки"| HOLD["Перевірка"]

  subgraph FE["Ознаки"]
    NORM["Норма кожного календарного місяця<br/>рахуємо лише на навчальних роках,<br/>щоб не підглядати в перевірку"]
    ANOM["Ціль: відхилення від норми<br/>для 3 показників одразу"]
    X["Вхід: відхилення за останні 3 місяці,<br/>норма цільового місяця, пора року"]
  end
  TRAIN --> NORM --> ANOM --> X

  subgraph FIT["Навчання на кожен місяць уперед, 1…12"]
    RFH["Random Forest"]
    EVAL["Похибка моделі на перевірці<br/>проти похибки простого «буде норма»"]
    PICK{"Модель точніша за норму?<br/>окремо для показника й місяця"}
  end
  X --> RFH --> EVAL --> PICK
  HOLD --> EVAL

  REFIT["Донавчаємо на всій історії<br/>і прогнозуємо від останнього місяця"]
  PICK -->|так| REFIT
  PICK -->|ні| ZERO["Прогноз = норма"]

  subgraph SEASON["Сезон: 3 місяці від поточного"]
    AGG["Сума опадів,<br/>середня температура й вологість"]
    CLIM["Ті самі 3 місяці за ~25 років<br/>→ межі третин: сухі, звичайні, вологі"]
    SIG["Розкид: мінливість минулих сезонів,<br/>звужена настільки, наскільки модель<br/>точніша за норму"]
    P["Ймовірність, що сезон впаде<br/>в нижню, середню чи верхню третину"]
    FLAT["Моделі не довіряємо → по третині"]
  end
  REFIT --> AGG
  ZERO --> AGG
  ANOM --> CLIM
  EVAL --> SIG
  CLIM --> SIG
  AGG --> P
  CLIM --> P
  SIG --> P
  ZERO --> FLAT

  P --> OUT["UI: 3 картки з ймовірностями<br/>+ межі «норми» для цього сезону<br/>+ де модель обіграла норму"]
  FLAT --> OUT
